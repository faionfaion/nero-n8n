{
	"name": "@n8n/nodes-nero",
	"version": "0.1.0",
	"description": "NERO AI platform nodes for n8n",
	"license": "SEE LICENSE IN LICENSE.md",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -w -p tsconfig.build.json",
